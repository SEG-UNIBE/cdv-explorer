    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import networkx as nx\\n\",\n",
    "    \"from matplotlib.lines import Line2D\\n\",\n",
    "    \"\\n\",\n",
    "    \"def draw_static_network(data, link_type='references', color_by='group'):\\n\",\n",
    "    \"    G = nx.DiGraph()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add nodes with attributes\\n\",\n",
    "    \"    for node in data['nodes']:\\n\",\n",
    "    \"        G.add_node(\\n\",\n",
    "    \"            node['id'],\\n\",\n",
    "    \"            group=node.get('group'),\\n\",\n",
    "    \"            compliance_score=node.get('compliance_score', 0)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add edges for the selected link type\\n\",\n",
    "    \"    for link in data['links'].get(link_type, []):\\n\",\n",
    "    \"        G.add_edge(link['source'], link['target'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Compute layout (spring = force-directed)\\n\",\n",
    "    \"    pos = nx.spring_layout(G, k=0.5, iterations=100, seed=42)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Color nodes\\n\",\n",
    "    \"    if color_by == 'compliance_score':\\n\",\n",
    "    \"        color_values = [\\n\",\n",
    "    \"            G.nodes[n].get('compliance_score', 0) or 0\\n\",\n",
    "    \"            for n in G.nodes\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"        cmap = plt.cm.Blues\\n\",\n",
    "    \"    else:  # color_by group\\n\",\n",
    "    \"        groups = list(set(nx.get_node_attributes(G, color_by).values()))\\n\",\n",
    "    \"        group_colors = plt.cm.tab10.colors  # Up to 10 unique colors\\n\",\n",
    "    \"\\n\",\n",
    "    \"        group_map = {group: group_colors[i % len(group_colors)] for i, group in enumerate(groups)}\\n\",\n",
    "    \"        color_values = [group_map.get(G.nodes[n].get(color_by), (0.5, 0.5, 0.5)) for n in G.nodes] \\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Draw\\n\",\n",
    "    \"    plt.figure(figsize=(12, 8))\\n\",\n",
    "    \"    if color_by == 'compliance_score':\\n\",\n",
    "    \"        nodes = nx.draw_networkx_nodes(\\n\",\n",
    "    \"            G, pos, node_size=300, node_color=color_values, cmap=cmap, alpha=0.85\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        nodes = nx.draw_networkx_nodes(\\n\",\n",
    "    \"            G, pos, node_size=300, node_color=color_values, alpha=0.85\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    edges = nx.draw_networkx_edges(G, pos, alpha=0.3, arrows=True, arrowstyle='->')\\n\",\n",
    "    \"    labels = nx.draw_networkx_labels(G, pos, font_size=8)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.title(f\\\"BIP Network - Link Type: {link_type} | Colored by: {color_by}\\\")\\n\",\n",
    "    \"    plt.axis('off')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if color_by == 'compliance_score':\\n\",\n",
    "    \"        plt.colorbar(nodes)\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        # Build custom legend for categories\\n\",\n",
    "    \"        legend_elements = [\\n\",\n",
    "    \"            Line2D([0], [0], marker='o', color='w', label=str(group),\\n\",\n",
    "    \"                   markerfacecolor=color, markersize=10)\\n\",\n",
    "    \"            for group, color in group_map.items()\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"        plt.legend(handles=legend_elements, title=color_by.capitalize(), loc='best')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\"\n",
    "   ]\n",
