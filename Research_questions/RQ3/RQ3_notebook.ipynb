    "    \"def compute_graph_depth(G):\\n\",\n",
    "    \"    longest_path_length = 0\\n\",\n",
    "    \"    for node in G.nodes:\\n\",\n",
    "    \"        if G.in_degree(node) == 0:  # root node\\n\",\n",
