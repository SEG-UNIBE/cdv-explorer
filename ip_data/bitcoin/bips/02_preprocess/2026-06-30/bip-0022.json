          "timestamp": "2026-08-07T07:58:31Z",
          "status": "success",
          "findings": [
            {
              "target": "bips:16",
              "type": "depends_on",
              "evidence": "Due to the [[bip-0016.mediawiki|BIP 0016]] changes regarding rules on block sigops, it is impossible to count sigops from the transactions themselves (the sigops in the scriptCheck must also be included in the count).",
              "reason": "Correctly supplying the transaction sigop counts required by the template depends on the block sigop-counting rules introduced by BIP 16.",
              "confidence": "high"
            },
            {
              "target": "bips:23",
              "type": "depends_on",
              "evidence": "If the request parameters include a \"mode\" key, that is used to explicitly select between the default \"template\" request or a [[bip-0023.mediawiki#block-proposal|\"proposal\"]].",
              "reason": "BIP 22 delegates the semantics of its proposal request mode to BIP 23, so that mode cannot be implemented from BIP 22 alone.",
              "confidence": "high"
            },
            {
              "target": "bips:34",
              "type": "depends_on",
              "evidence": "This does not include the block height, which is required to be included in the scriptSig by [[bip-0034.mediawiki|BIP 0034]].",
              "reason": "The coinbase template format relies on BIP 34's rule requiring the block height in the coinbase scriptSig.",
              "confidence": "high"
            }
          ]
        }
      ]
    }
