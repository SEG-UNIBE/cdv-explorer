          "dependencies": [
            {
              "target": "bips:21",
              "evidence": "via a bip21 encoded address",
              "reason": "The proposal normatively defines sender-to-receiver discovery using a BIP21 Bitcoin URI and adds a new key-value parameter within that encoding, so implementing this mechanism materially depends on the BIP21 URI format.",
              "confidence": "high"
            },
            {
              "target": "bips:69",
              "evidence": "sorted according to BIP69, if so ensure the result stays that way",
              "reason": "The receiver is instructed to preserve BIP69 input/output sorting when the template transaction already uses it. That makes compatibility with the target's deterministic ordering rules part of processing the proposal in those cases.",
              "confidence": "medium"
            },
            {
              "target": "bips:125",
              "evidence": "encouraged to use a slightly more aggressive feerate than usual as well as BIP125 (Opt-in Full Replace-by-Fee Signaling)",
              "reason": "The protocol's transaction publishing behavior explicitly contemplates publishing the template transaction after the finalized transaction is on the network 'taking advantage of replace-by-fee', and the text specifically names BIP125 as the signaling mechanism. This is a substantive optional compatibility mechanism rather than a mere mention.",
              "confidence": "medium"
            }
          ]
        }
