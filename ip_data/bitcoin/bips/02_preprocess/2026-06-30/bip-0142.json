            {
              "target": "bips:16",
              "evidence": "Segwit-in-P2SH is a BIP16 P2SH redeemScript",
              "reason": "The rationale materially relies on the BIP16 P2SH embedding mechanism as one of the two BIP141 witness-program encodings and contrasts the new native format against that compatibility path.",
              "confidence": "medium"
            },
            {
              "target": "bips:141",
              "evidence": "The new Bitcoin address format defined is for the Pay-to-Witness-Public-Key-Hash (P2WPKH) and Pay-to-Witness-Script-Hash (P2WSH) transaction described in segregated witness soft fork (BIP141).",
              "reason": "The proposal defines address encodings specifically for the witness-program transaction types introduced by BIP141, and repeatedly relies on BIP141's witness program versions, scriptPubKey structure, and native witness semantics.",
              "confidence": "high"
            }
          ]
