{
  "name": "cdv-explorer",
  "version": "4.1.2",
  "description": "Mining and analysis dashboard for CDV-exhibiting OSS ecosystems",
  "author": "Roman Bögli",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@nivo/core": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "@nivo/tooltip": "^0.99.0",
    "d3": "^7.9.0",
    "d3-cloud": "^1.2.9",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.2",
    "primereact": "^11.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4"
  },
  "scripts": {
    "postinstall": "patch-package",
    "generate:indexes": "node scripts/generateEcosystemConfig.js && node scripts/generateSnapshotIndex.js && node scripts/generateProposalLinkIndex.js && node scripts/syncPublicData.js",
    "prestart": "npm run generate:indexes",
    "start": "vite",
